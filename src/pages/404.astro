---
import Base from "../layouts/Base.astro";
import Topbar from "../components/Topbar.astro";
import Footer from "../components/sections/Footer.astro";
import ScrollRing from "../components/ScrollRing.astro";
import Icon from "../components/Icon.astro";
import { site } from "../lib/site";
---
<Base title={`Seite nicht gefunden | ${site.name}`}>
  <Topbar path="/404" />
  <main>
    <section class="nf-hero">
      <ScrollRing images={site.ring} radius={360} scrollSpeed={0.02} autoSpin={2} />
      <div class="nf-content">
        <h1 class="h1">Seite nicht gefunden</h1>
        <p class="body muted balance nf-text">Die gesuchte Seite gibt es nicht oder sie wurde verschoben. So findest du zurück auf den richtigen Weg.</p>
        <a class="btn" href="/"><span class="body-sb">Zur Startseite</span><Icon name="arrow-up-right" size={20} /></a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
